#!/usr/bin/env bash

set -eo pipefail
declare PROJLOC=..
declare HERE
HERE="$(dirname "$0")"

ex01() {

  echo "01 - Create a simple definition for a first service"

  cds init simple \
    && cd "$_"

  cat << EOSERVICES > services.cds
service Simple {
  entity Products {
    key ID    : Integer;
        name  : String;
        stock : Integer;
  }
}
EOSERVICES

  cds add data

  cat << EODATA > db/data/Simple.Products.csv
1,Chai,39
2,Chang,17
3,Aniseed Syrup,13
EODATA
}

ex02() {

  ex01
  echo "02 - Understand the basic model, services and persistence features"

}

ex03() {

  ex02
  echo "03 - Separate out the data model from the service definition"

  cat << EOSCHEMA > db/schema.cds
namespace workshop;

entity Products {
  key ID    : Integer;
      name  : String;
      stock : Integer;
}
EOSCHEMA

  cat << EOSERVICE > srv/simple.cds
using workshop from '../db/schema';

service Simple {
  entity Products as projection on workshop.Products;
}
EOSERVICE

  rm -f services.cds
  mv db/data/Simple.Products.csv db/data/workshop-Products.csv

}

ex04() {

  ex03
  echo "04 - Design and use custom types for a richer entity definition"

  cat << EOSCHEMA > db/schema.cds
namespace workshop;

type Price {
  amount   : Decimal;
  currency : String;
}

entity Products {
  key ID    : Integer;
      name  : String;
      stock : Integer;
      price : Price;
}
EOSCHEMA

}

ex05() {

  ex04
  echo "05 - Explore reuse and standard common definitions"

  cat << EOCOMMON > db/common.cds
type Currency : Association to sap.common.Currencies;

context sap.common {

  entity Currencies : CodeList {
    key code      : String(3);
        symbol    : String(5);
        minorUnit : Int16;
  }

  aspect CodeList {
    name  : String(255);
    descr : String(1000);
  }

}
EOCOMMON

  cat << EOSCHEMA > db/schema.cds
using Currency from '@sap/cds/common';

namespace workshop;

type Price {
  amount   : Decimal;
  currency : Currency;
}

entity Products {
  key ID    : Integer;
      name  : String;
      stock : Integer;
      price : Price;
}
EOSCHEMA

  sed -i 's/@sap\/cds\/common/\.\/common/' db/schema.cds

  cds add data --force

}

ex06() {

  ex05
  echo "06 - Understand and use aspects"

  rm -f db/common.cds

  cat << EOSCHEMA > db/schema.cds
using {Currency} from '@sap/cds/common';

namespace workshop;

aspect cuid {
  key ID : Integer;
}

type Price {
  amount   : Decimal;
  currency : Currency;
}

entity Products : cuid {
  name  : String;
  stock : Integer;
  price : Price;
}

entity Suppliers : cuid {
  company : String;
}
EOSCHEMA

}

ex07() {

  ex06
  echo "07 - Link entities together with associations"

  cat << EOSCHEMA > db/schema.cds
using {Currency} from '@sap/cds/common';

namespace workshop;

aspect cuid {
  key ID : Integer;
}

type Price {
  amount   : Decimal;
  currency : Currency;
}

entity Products : cuid {
  name     : String;
  stock    : Integer;
  price    : Price;
  supplier : Association to Suppliers;
}

entity Suppliers : cuid {
  company  : String;
  products : Association to many Products
               on products.supplier = \$self;
}
EOSCHEMA

  cds add data --force

  cp ../exercises/07/assets/workshop-*.csv db/data/

  cat << EOSERVICE > srv/simple.cds
using workshop from '../db/schema';

service Simple {
  entity Products  as projection on workshop.Products;
  entity Suppliers as projection on workshop.Suppliers;
}
EOSERVICE

}

ex08() {

  ex07
  echo "08 - Defined contained-in relationships with compositions"

  cat << EOORDERS >> db/schema.cds

entity Orders : cuid {
  date  : Date default \$now;
  items : Composition of many {
            key pos      : Integer;
                product  : Association to Products;
                quantity : Integer;
          }
}
EOORDERS

  cds add data --filter Orders

}

ex09() {

  ex08
  echo "09 - Try out deep inserts and cascaded deletes"

  cat << EOSERVICE > srv/simple.cds
using workshop from '../db/schema';

@protocol: 'odata'
@path    : '/simple'
service Simple {
  entity Products  as projection on workshop.Products;
  entity Suppliers as projection on workshop.Suppliers;
  entity Orders    as projection on workshop.Orders;
}
EOSERVICE

  cp ../exercises/09/assets/workshop-Orders*.csv db/data/
  cp ../exercises/09/assets/sap.common-Currencies.csv db/data/

  cds deploy --to sqlite

  # echo 'cds.requires.db.kind=sqlite' > .env (only temporary)

}

ex10() {

  ex09
  echo "10 - Explore projections with a second service"

  mv srv/simple.cds srv/ecommerce.cds

  cat << EOACCOUNTING >> srv/ecommerce.cds

service Accounting {
  entity Valuations as
    projection on workshop.Products {
      ID                   as ProductID,
      name                 as ProductName,
      stock * price.amount as StockValue : Decimal,
      price.currency.name  as Currency,
      supplier.company     as Source
    }
}
EOACCOUNTING

}

resetproj() {

  echo "00 - Reset"
  rm -rf simple/

}

main() {

  local ex="${1:?Specify exercise number e.g. 01}"
  [[ "${#ex}" == 1 ]] && ex="0${ex}" # zero prefix
  mkdir -p "$HERE/$PROJLOC" \
    && cd "$HERE/$PROJLOC"
  resetproj
  "ex$ex"

}

main "$@"
